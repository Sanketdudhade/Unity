rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions enforcing trusted authentication, custom claims, and Firestore profile fallback
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasValidClaims() {
      return isAuthenticated() &&
        request.auth.token.role in ['ADMIN', 'EMPLOYEE'] &&
        request.auth.token.organizationId is string &&
        request.auth.token.organizationId.size() > 0;
    }

    function isOrgMember(organizationId) {
      return isAuthenticated() && (
        (hasValidClaims() && request.auth.token.organizationId == organizationId) ||
        (userDocExists() &&
         getUserDoc().organizationId == organizationId &&
         getUserDoc().role in ['ADMIN', 'EMPLOYEE'] &&
         (getUserDoc().isActive == null || getUserDoc().isActive == true))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (hasValidClaims() && request.auth.token.role == 'ADMIN') ||
        (userDocExists() &&
         getUserDoc().role == 'ADMIN' &&
         (getUserDoc().isActive == null || getUserDoc().isActive == true))
      );
    }

    function getCallerOrgId() {
      return (request.auth.token.organizationId != null && request.auth.token.organizationId is string)
        ? request.auth.token.organizationId
        : (userDocExists() ? getUserDoc().organizationId : '');
    }

    // 1. Users collection: users/{uid}
    // Authenticated users can read profile/directory records; authenticated admins/users can create/update.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 2. Organization-scoped collections
    match /organizations/{organizationId} {
      allow read: if isOrgMember(organizationId);
      allow write: if false;

      // Employee directory
      match /employees/{employeeId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isAdmin() && isOrgMember(organizationId);
        allow delete: if isAdmin() && isOrgMember(organizationId);
      }

      // Products master
      match /products/{productId} {
        allow read: if isOrgMember(organizationId);
        allow create, update, delete: if isAdmin() && isOrgMember(organizationId);

        // Product BOMs subcollection
        match /boms/{bomId} {
          allow read: if isOrgMember(organizationId);
          allow create, update, delete: if isAdmin() && isOrgMember(organizationId);
        }

        // Product BOM Files subcollection
        match /bomFiles/{fileId} {
          allow read: if isOrgMember(organizationId);
          allow create, update, delete: if isAdmin() && isOrgMember(organizationId);
        }
      }

      // Process templates and steps
      match /processTemplates/{templateId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isAdmin() && isOrgMember(organizationId);

        match /steps/{stepId} {
          allow read: if isOrgMember(organizationId);
          allow create, update, delete: if isAdmin() && isOrgMember(organizationId);
        }
      }

      // Production orders, processes, and daily updates
      match /productionOrders/{orderId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);

        match /processes/{processId} {
          allow read: if isOrgMember(organizationId);
          allow create, update: if isOrgMember(organizationId);

          match /updates/{updateId} {
            allow read: if isOrgMember(organizationId);
            allow create: if isOrgMember(organizationId);
          }
        }
      }

      // Materials master
      match /materials/{materialId} {
        allow read: if isOrgMember(organizationId);
        allow create, delete: if isAdmin() && isOrgMember(organizationId);
        allow update: if (isAdmin() && isOrgMember(organizationId)) ||
          (isOrgMember(organizationId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']));
      }

      // Inventory balances: read-only from clients, modified via atomic transactions / functions
      match /inventoryBalances/{materialLocationId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);
        allow delete: if false;
      }

      // Authoritative immutable inventory ledger
      match /inventoryTransactions/{transactionId} {
        allow read: if isOrgMember(organizationId);
        allow create: if isOrgMember(organizationId);
        allow update, delete: if false; // strictly immutable
      }

      // Process queries and responses
      match /processQueries/{queryId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);

        match /responses/{responseId} {
          allow read: if isOrgMember(organizationId);
          allow create: if isOrgMember(organizationId);
        }
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read: if isOrgMember(organizationId) && (resource.data.recipientUid == request.auth.uid || isAdmin());
        allow create, update: if isOrgMember(organizationId);
      }

      // Audit logs: append-only
      match /auditLogs/{auditId} {
        allow read: if isOrgMember(organizationId) && isAdmin();
        allow create: if isOrgMember(organizationId);
        allow update, delete: if false;
      }

      // Billing & Invoices: Strictly Admin Only
      match /invoices/{invoiceId} {
        allow read, write: if isAdmin() && isOrgMember(organizationId);

        match /payments/{paymentId} {
          allow read, write: if isAdmin() && isOrgMember(organizationId);
        }

        match /documents/{docId} {
          allow read, write: if isAdmin() && isOrgMember(organizationId);
        }
      }

      // Billing Customers directory: Admin Only
      match /customers/{customerId} {
        allow read, write: if isAdmin() && isOrgMember(organizationId);
      }

      // Billing Configuration (Company GST & Bank details): Admin Only
      match /billingConfig/{configId} {
        allow read, write: if isAdmin() && isOrgMember(organizationId);
      }

      // Invoice Sequence counters for atomic sequential numbering: Admin Only
      match /invoiceCounters/{counterId} {
        allow read, write: if isAdmin() && isOrgMember(organizationId);
      }

      // Jobwork Purchase Orders (M&G Stage 4)
      match /jobworkPOs/{poId} {
        allow read, write: if isOrgMember(organizationId) && isAdmin();
      }

      // Backward-compatibility aliases
      match /production_orders/{orderId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);
      }

      match /process_tasks/{taskId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);
      }

      match /status_updates/{updateId} {
        allow read: if isOrgMember(organizationId);
        allow create: if isOrgMember(organizationId);
      }

      match /process_queries/{queryId} {
        allow read: if isOrgMember(organizationId);
        allow create, update: if isOrgMember(organizationId);
      }
    }

    // Root-level Billing & Invoices (Admin Only fallback)
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && isAdmin();
      match /payments/{paymentId} {
        allow read, write: if isAuthenticated() && isAdmin();
      }
      match /documents/{docId} {
        allow read, write: if isAuthenticated() && isAdmin();
      }
    }
    match /customers/{customerId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    match /billingConfig/{configId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    match /invoiceCounters/{counterId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    match /jobworkPOs/{poId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
